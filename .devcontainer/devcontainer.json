{
  "name": "Laravel CRM (Codespaces)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/laravel-crm",

  "forwardPorts": [8000, 5173, 3306],
  "portsAttributes": {
    "8000": { "label": "Web",  "visibility": "public" },
    "5173": { "label": "Vite", "visibility": "public" },
    "3306": { "label": "MySQL","visibility": "private" }
  },

  "postCreateCommand": "php -m | grep -E 'pdo_mysql|gd|zip|calendar' || true",
  "postStartCommand": "git config --global --add safe.directory /workspaces/laravel-crm",
  "remoteUser": "vscode"
}
